netcdf netcdf4_oracle {
dimensions:
    radius = 3 ;
    mode = 2 ;
variables:
    int count ;
    double huge_value ;
    int indices(mode) ;
    double radius(radius) ;
        radius:units = "m" ;
    double radius_values(radius) ;
    double coefficients(mode, radius) ;

// global attributes:
        :rho_convention = "rho_tor" ;
        :zeta_convention = "cyl" ;
        :rho_lcfs = 1. ;
        :boozer_field = 1 ;
        :torflux = 1.25 ;
        :gvec2chartmap_boozer_factor = 1LL ;
data:
    count = 3 ;
    huge_value = 1.e300 ;
    indices = 4, 9 ;
    radius = 0, 0.5, 1 ;
    radius_values = 1.25, -2.5, 4.75 ;
    coefficients = 1, 2, 3, 4, 5, 6 ;
}
