netcdf netcdf4_oracle {
dimensions:
    radius = 3 ;
    mode = 2 ;
variables:
    int count ;
    int indices(mode) ;
    double radius(radius) ;
        radius:units = "m" ;
    double radius_values(radius) ;
    double coefficients(mode, radius) ;

// global attributes:
        :zeta_convention = "cyl" ;
data:
    count = 3 ;
    indices = 4, 9 ;
    radius = 0, 0.5, 1 ;
    radius_values = 1.25, -2.5, 4.75 ;
    coefficients = 1, 2, 3, 4, 5, 6 ;
}
